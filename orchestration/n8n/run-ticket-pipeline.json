    {
      "parameters": {
        "jsCode": "// A webhook node does not hand on the posted body — it hands on an envelope:\n// { headers, params, query, body }. Spreading THAT put `headers` and `query`\n// into the state and left every field of the snapshot undefined, so the first\n// node to use one — `Callback: started`, reading `callback_url` — failed with\n// ERR_INVALID_URL, and the app reported 'orchestrator answered 500'.\n//\n// `?? json` so the workflow can still be run by hand from the n8n editor with\n// a snapshot pasted straight in, where there is no envelope.\nconst json = $input.first().json;\nconst s = json.body ?? json;\nif (!s || !s.run_id) {\n  throw new Error('the posted body is not a run snapshot: no run_id in it');\n}\n// Continuing a run the application asked to pick up again: the body carries\n// a resume block saying where to start and what is already known — the\n// first unfinished step, the facts the specification step established, the\n// cost spent so far. Absent, this is a fresh run and the loop starts at zero.\nconst r = s.resume ?? {};\nconst index = Number.isInteger(r.index) && r.index >= 0 ? r.index : 0;\nconst { resume: _resume, ...snapshot } = s;\nreturn [{ json: { ...snapshot, index, facts: r.facts ?? {}, spent_usd: Number(r.spent_usd ?? 0), step_index: index } }];"
      },
