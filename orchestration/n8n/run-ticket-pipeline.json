    {
      "parameters": {
        "jsCode": "\n// Mirrors packages/shared/src/step-loop.ts \u2014 the orchestrator's ONLY logic:\n// evaluate the condition, then branch on the type. It knows nothing about what\n// a specification, a design or a plan is (Constitution Principle III).\nconst state = $input.first().json;\nconst steps = state.pipeline.steps;\nconst index = state.index ?? 0;\nconst facts = state.facts ?? {};\n\nfunction conditionHolds(condition) {\n  if (condition === 'always') return true;\n  if (condition === 'ticket_has_ui') return facts.hasUi === true;\n  if (condition === 'ticket_has_no_ui') return facts.hasUi !== true;\n  return true;\n}\n\nconst CONDITION_TEXT = {\n  ticket_has_ui: 'ticket has no UI change',\n  ticket_has_no_ui: 'ticket changes the interface'\n};\n\nif (index >= steps.length) {\n  return [{ json: { ...state, action: 'finish' } }];\n}\nconst step = steps[index];\nif (conditionHolds(step.condition)) {\n  return [{ json: { ...state, action: 'run', step, step_index: index } }];\n}\nreturn [\n  {\n    json: {\n      ...state,\n      action: 'skip',\n      step,\n      step_index: index,\n      condition_not_met: CONDITION_TEXT[step.condition] ?? 'never'\n    }\n  }\n];\n"
      },
