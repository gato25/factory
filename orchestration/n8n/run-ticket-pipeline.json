    {
      "parameters": {
        "jsCode": "// Where the state comes from, said explicitly.\n//\n// This node is reached from four places, and three of them are an HTTP request\n// or a Wait — so `$input` holds whatever answered last, not the run. The state\n// is taken from the decision that started this iteration; the reply is whatever\n// did answer, which is exactly what carries a pause or an approval.\nconst state = $('Decide next step').first().json;\nconst reply = $input.first().json ?? {};\n// The step's own outcome, when a step ran at all — a skipped step never called\n// the runner, and asking a node that did not execute for its data throws.\nconst result = $('Runner: run step').isExecuted\n  ? ($('Runner: run step').first().json ?? {})\n  : {};\n\n// The step did not run at all. `Runner: run step` sets `neverError` too,\n// so this is what a refused or impossible step looks like, and treating\n// it as a finished one is what let a run reach its checkpoint having\n// executed nothing.\nif (result.error) {\n  return [{ json: { ...state, action: 'fail',\n    reason: result.reason ?? 'step_failed', detail: result.error } }];\n}\n\nconst facts = { ...(state.facts ?? {}) };\nif (result.classification) facts.hasUi = result.classification.has_ui;\n\n// The app's latest word on whether a pause was asked for, wherever it reached\n// us from: a callback reply, or the body that resumed a wait.\nconst paused = reply.paused === true || reply.callback?.paused === true || state.paused === true;\n\n// A ceiling reached is a failure, checked after every step (FR-081).\nconst spent = Number(state.spent_usd ?? 0) + Number(result.costUsd ?? 0);\nconst ceiling = Number(state.limits.cost_ceiling_usd);\nif (spent > ceiling) {\n  return [{ json: { ...state, facts, spent_usd: spent, action: 'fail',\n    reason: 'budget_exceeded',\n    detail: `the run reached its ceiling of $${ceiling.toFixed(4)}` } }];\n}\n\n// A change request at a checkpoint re-runs the PRECEDING step with the\n// feedback, then returns to the same checkpoint (FR-061).\nconst decision = reply.resume?.decision ?? reply.decision ?? state.decision;\nconst feedback = reply.resume?.feedback ?? reply.feedback ?? state.feedback;\nif (decision === 'changes_requested') {\n  const steps = state.pipeline.steps;\n  let back = (state.step_index ?? 0) - 1;\n  while (back >= 0 && !['agent', 'design', 'shell'].includes(steps[back].type)) back--;\n  if (back >= 0) {\n    return [{ json: { ...state, facts, spent_usd: spent, index: back,\n      feedback, returning_to: state.step_index } }];\n  }\n}\n// After a re-run triggered by a change request, come back to the checkpoint.\nif (state.returning_to !== undefined && state.returning_to !== null) {\n  return [{ json: { ...state, facts, spent_usd: spent, index: state.returning_to,\n    returning_to: null, feedback: null } }];\n}\nreturn [{ json: { ...state, facts, paused, spent_usd: spent, index: (state.step_index ?? 0) + 1 } }];"
      },
