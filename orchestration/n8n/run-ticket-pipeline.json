    {
      "parameters": {
        "jsCode": "// A run that has already failed decides nothing else.\n//\n// Checked before anything reads the pipeline, because the failure is that\n// the sandbox does not exist: there is nothing to run a step in, and every\n// step would answer \"that run has no sandbox\" in turn.\nconst incoming = $input.first().json;\nif (incoming.fatal) {\n  return [{ json: { ...incoming, action: 'fail',\n    reason: incoming.fatal.reason, detail: incoming.fatal.detail } }];\n}\n\n\n// Mirrors packages/shared/src/step-loop.ts — the orchestrator's ONLY logic:\n// evaluate the condition, then branch on the type. It knows nothing about what\n// a specification, a design or a plan is (Constitution Principle III).\nconst state = $input.first().json;\nconst steps = state.pipeline.steps;\nconst index = state.index ?? 0;\nconst facts = state.facts ?? {};\n\nfunction conditionHolds(condition) {\n  if (condition === 'always') return true;\n  if (condition === 'ticket_has_ui') return facts.hasUi === true;\n  if (condition === 'ticket_has_no_ui') return facts.hasUi !== true;\n  return true;\n}\n\nconst CONDITION_TEXT = {\n  ticket_has_ui: 'ticket has no UI change',\n  ticket_has_no_ui: 'ticket changes the interface'\n};\n\nif (index >= steps.length) {\n  return [{ json: { ...state, action: 'finish' } }];\n}\n// A pause was asked for: the step that was running has already concluded and\n// been reported, and nothing further begins (FR-096). The run keeps its\n// status, so the interface shows exactly where it stopped.\nif (state.paused === true) {\n  return [{ json: { ...state, action: 'hold', step_index: index } }];\n}\nconst step = steps[index];\nif (conditionHolds(step.condition)) {\n  return [{ json: { ...state, action: 'run', step, step_index: index } }];\n}\nreturn [\n  {\n    json: {\n      ...state,\n      action: 'skip',\n      step,\n      step_index: index,\n      condition_not_met: CONDITION_TEXT[step.condition] ?? 'never'\n    }\n  }\n];\n"
      },
