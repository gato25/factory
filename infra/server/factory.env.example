# The environment of a Code Factory server (docs/operations.md, "On a Linux
# server"). One file for all three pieces: the web application's and the
# maintenance pass's systemd units read it with EnvironmentFile=, and the
# runner's compose file reads it with --env-file.
#
#   sudo install -d -m 0750 -o root -g factory /etc/code-factory
#   sudo install -m 0640 -o root -g factory infra/server/factory.env.example /etc/code-factory/factory.env
#
# Then fill in every blank and replace factory.example.com. One KEY=value per
# line, unquoted, and comments on lines of their own — systemd reads anything
# after a value, a "# comment" included, as part of the value.

# --- Where people reach it -----------------------------------------------------

# The address in every link, sign-in callback and merge request. It must be
# https://: the session cookie is Secure, and the application refuses to
# start on a plain-HTTP address.
PUBLIC_BASE_URL=https://factory.example.com
# The same address, for the web server itself: forms are accepted only from
# here, whatever Host header the proxy sends.
ORIGIN=https://factory.example.com
# The largest request accepted; a requirement file is uploaded in one. Keep it
# equal to client_max_body_size in the nginx configuration.
BODY_SIZE_LIMIT=10M
# Where the runner reaches this application: its own port on this machine,
# never through nginx, which refuses the runner's routes from outside.
CALLBACK_BASE_URL=http://127.0.0.1:3000

# --- The database --------------------------------------------------------------

DATABASE_URL=postgres://factory:CHANGE-ME@127.0.0.1:5432/factory

# --- Secrets: generate each one; the application refuses the examples ----------

# openssl rand -hex 32
SESSION_SECRET=
# openssl rand -base64 32 — and keep a copy somewhere safe: without it every
# stored credential is lost (docs/operations.md, "Rotating the encryption key").
SECRET_ENCRYPTION_KEY=
SECRET_ENCRYPTION_KEY_VERSION=v1
SECRET_ENCRYPTION_KEYS_PREVIOUS=

# --- The runner ----------------------------------------------------------------

# openssl rand -hex 32 — the one value both services use.
RUNNER_AUTH_TOKEN=
RUNNER_AUTH_TOKEN_PREVIOUS=
RUNNER_BASE_URL=http://127.0.0.1:8080
RUNNER_PORT=8080
SANDBOX_IMAGE=code-factory/sandbox:latest
# Where runs are made, at the same path on the host and in the container.
FACTORY_RUNS_DIR=/srv/factory/runs
# The group that owns the Docker socket: stat -c %g /var/run/docker.sock
DOCKER_GID=

# --- The model credential (optional) -------------------------------------------

# Read once, at the first start, and stored sealed; or paste it in Settings.
ANTHROPIC_API_KEY=
CLAUDE_CODE_OAUTH_TOKEN=

# --- Signing in with a provider ------------------------------------------------

# At least one is the practical choice. The callbacks to register are
# https://factory.example.com/login/gitlab/callback and …/login/github/callback.
GITLAB_CLIENT_ID=
GITLAB_CLIENT_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
