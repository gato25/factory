# The web application as a systemd service (docs/operations.md, "On a Linux
# server"): the built app on 127.0.0.1:3000, with nginx in front for TLS.
#
#   sudo cp infra/server/code-factory-web.service /etc/systemd/system/
#   sudo systemctl daemon-reload
#   sudo systemctl enable --now code-factory-web
#   journalctl -u code-factory-web -f
[Unit]
Description=Code Factory web application
Documentation=file:///srv/code-factory/docs/operations.md
After=network-online.target postgresql.service
Wants=network-online.target
# An incomplete configuration is refused at startup, with every problem named
# in the journal. Stop after a few tries rather than log the same refusal
# forever.
StartLimitIntervalSec=120
StartLimitBurst=5

[Service]
Type=simple
User=factory
Group=factory
WorkingDirectory=/srv/code-factory/apps/web
EnvironmentFile=/etc/code-factory/factory.env
Environment=NODE_ENV=production
Environment=HOST=127.0.0.1
Environment=PORT=3000
ExecStart=/usr/bin/node build
Restart=on-failure
RestartSec=5
# On SIGTERM the server stops taking requests, lets an open live-update
# stream finish for up to 30 seconds (SHUTDOWN_TIMEOUT), closes its database
# connections and exits 0.
TimeoutStopSec=45

# It writes nothing to disk: everything it keeps is in Postgres.
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictSUIDSGID=true
LockPersonality=true

[Install]
WantedBy=multi-user.target
