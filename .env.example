# Copy to .env for local development. Never commit .env.
DATABASE_URL=postgres://postgres:postgres@localhost:5432/factory
# The two addresses below are also copied into Settings the first time the
# application starts, so they are typed once. From the moment somebody saves
# Settings, Settings is what counts; clearing a field there asks for the
# value here again.
RUNNER_BASE_URL=http://localhost:8080
RUNNER_AUTH_TOKEN=change-me
# The outgoing credential, accepted alongside RUNNER_AUTH_TOKEN while a
# replacement is rolled out. Replacing the credential is a two-sided change —
# the execution service is told the new one, then every caller is — and those
# cannot happen in the same instant, so both are accepted for a window.
# REMOVING this variable is what refuses the old one. Leave it unset normally.
RUNNER_AUTH_TOKEN_PREVIOUS=
# Where a run's sandbox comes from: `docker` is a container daemon you
# administer, `hosted` is a managed sandbox service. This is the whole of the
# switch — no code change, no rebuild — and it is also the rollback.
#
# It is read by the EXECUTION SERVICE, not by the web application, so it
# belongs in the runner's own environment (for the hosted deployment, in
# apps/runner/wrangler.jsonc). Defaults to `docker`, so a deployment that has
# never heard of any of this keeps behaving exactly as it did.
#
# On `hosted` the service refuses to start without an explicit
# RUNNER_AUTH_TOKEN: a hosted deployment is publicly reachable, so the
# development default would let anyone drive it.
EXECUTION_HOST=docker
ORCHESTRATOR_BASE_URL=http://localhost:5678
ORCHESTRATOR_API_KEY=
PUBLIC_BASE_URL=http://localhost:5173
SESSION_SECRET=change-me-to-32-plus-random-bytes
# base64 of exactly 32 bytes: openssl rand -base64 32
SECRET_ENCRYPTION_KEY=
# Which key the above is, recorded on every credential it seals. Default v1.
SECRET_ENCRYPTION_KEY_VERSION=
# Retired keys, as version:base64,version:base64. Rotating the key above
# without keeping the old one here makes every credential already stored
# undecryptable, and the only remedy is re-entering every token.
SECRET_ENCRYPTION_KEYS_PREVIOUS=
# The model credential, read ONCE when the application first starts and
# stored sealed in the database — after that it lives in Settings and these
# lines are ignored. Either an API key or a subscription token from
# `claude setup-token`; the first one set wins. Optional: leave both blank and
# paste the credential in Settings instead. Storing it needs
# SECRET_ENCRYPTION_KEY above, because that is what seals it.
ANTHROPIC_API_KEY=
CLAUDE_CODE_OAUTH_TOKEN=
# Signing in with a provider (FR-001). A provider with no client id and
# secret is not offered on the sign-in screen at all, rather than offered as
# a link that fails. The callback to register with each is
# <PUBLIC_BASE_URL>/login/<gitlab|github>/callback.
GITLAB_CLIENT_ID=
GITLAB_CLIENT_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
# Only needed where a pinned Chromium is preinstalled and must be used as-is.
PLAYWRIGHT_CHROMIUM_PATH=
