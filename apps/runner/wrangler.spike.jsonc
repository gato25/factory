{
  // Deployment for the spike in `spikes/worker.ts` — T005, T006 and T007.
  //
  // Separate from wrangler.jsonc on purpose: this is throwaway, it declares two
  // differently sized bindings that the real service does not need in this
  // shape, and nothing about it should end up in a deployment anybody depends
  // on. Delete it together with spikes/ once the three answers are recorded in
  // research.md (that is T061).
  //
  //   bunx wrangler deploy --config apps/runner/wrangler.spike.jsonc
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "factory-runner-spike",
  "main": "spikes/worker.ts",
  "compatibility_date": "2026-09-11",

  "durable_objects": {
    "bindings": [
      { "name": "SPIKE_SMALL", "class_name": "SpikeSmall" },
      { "name": "SPIKE_LARGE", "class_name": "SpikeLarge" }
    ]
  },

  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": ["SpikeSmall", "SpikeLarge"]
    }
  ],

  // Two sizes, deliberately far apart so `/sizes` cannot pass by accident.
  // `instance_type` is deploy-time configuration — that it cannot be set per
  // sandbox at runtime is the whole reason D4 exists.
  //
  // The provider enforces AT LEAST 3 GiB of memory per vCPU for the first four
  // vCPUs, so 1 vCPU needs 3 GiB, 2 vCPU needs 6 GiB and 4 vCPU needs 12 GiB.
  // A first attempt at this file asked for 2 vCPU with 4096 MiB and was
  // refused at validation — which is how we learned the shipped workspace
  // default of 2 vCPU / 4096 MiB cannot exist here at all.
  //
  // So the small size is 1 vCPU / 4096 MiB: the largest allocation that fits
  // WITHIN those defaults, which under FR-009 is exactly what the real
  // deployment would route a default workspace to. Deliberately chosen over a
  // legal-but-arbitrary size, because it makes `/sizes` report what a real run
  // would actually get.
  "containers": [
    {
      "class_name": "SpikeSmall",
      "image": "./../../infra/sandbox/Dockerfile",
      "instance_type": { "vcpu": 1, "memory_mib": 4096, "disk_mb": 8000 },
      "max_instances": 2
    },
    {
      "class_name": "SpikeLarge",
      "image": "./../../infra/sandbox/Dockerfile",
      "instance_type": { "vcpu": 4, "memory_mib": 12288, "disk_mb": 20000 },
      "max_instances": 2
    }
  ],

  "observability": {
    "enabled": true
  }
}
